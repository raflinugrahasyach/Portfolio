import tensorflow as tf
from tensorflow.keras.applications import MobileNetV2
from tensorflow.keras.layers import Dense, GlobalAveragePooling2D
from tensorflow.keras.models import Model
from tensorflow.keras.preprocessing.image import ImageDataGenerator

# --- 1. SETUP AUGMENTASI DATA ---
train_datagen = ImageDataGenerator(
    rescale=1./255,
    rotation_range=30,
    width_shift_range=0.2,
    height_shift_range=0.2,
    brightness_range=[0.6, 1.4], # Rentang cahaya diperluas untuk webcam
    shear_range=0.2,
    zoom_range=0.2,
    horizontal_flip=True,
    fill_mode='nearest',
    validation_split=0.2 # 20% data untuk validasi
)

# --- 2. GENERATOR DATA ---
train_generator = train_datagen.flow_from_directory(
    base_dir,
    target_size=(224, 224),
    batch_size=32,
    class_mode='categorical',
    subset='training'
)

val_generator = train_datagen.flow_from_directory(
    base_dir,
    target_size=(224, 224),
    batch_size=32,
    class_mode='categorical',
    subset='validation'
)

# --- 3. BANGUN MODEL MOBILENETV2 ---
base_model = MobileNetV2(weights='imagenet', include_top=False, input_shape=(224, 224, 3))

# Kunci layer bawaan agar tidak merusak bobot imagenet
base_model.trainable = False 

x = base_model.output
x = GlobalAveragePooling2D()(x)
x = Dense(128, activation='relu')(x)
predictions = Dense(3, activation='softmax')(x) # 3 Kelas: Apel, Tomat Masak, Tomat Mentah

model = Model(inputs=base_model.input, outputs=predictions)

print("✅ Model MobileNetV2 siap dilatih!")





# --- 1. COMPILE MODEL ---
model.compile(optimizer='adam', loss='categorical_crossentropy', metrics=['accuracy'])

# --- 2. MULAI TRAINING ---
print("🚀 Memulai Training... (Tunggu 10-15 Menit)")
history = model.fit(
    train_generator,
    validation_data=val_generator,
    epochs=15  # 15 epoch sudah cukup untuk Transfer Learning
)

# --- 3. SIMPAN MODEL ---
model.save('model_buah_v1.h5')
print("\n✅ File 'model_buah_v1.h5' BERHASIL DISIMPAN!")

# --- 4. CEK LABEL (PENTING BANGET BUAT DI WEB NANTI) ---
print("\n⚠️ ========================================")
print("⚠️ CATAT URUTAN LABEL INI UNTUK APP.PY:")
print(train_generator.class_indices)
print("⚠️ ========================================\n")




















import os

def check_dataset_detail(start_path='/kaggle/input'):
    print(f"{'TOTAL GAMBAR':<15} | {'PATH LENGKAP'}")
    print("-" * 80)
    
    # Ekstensi gambar yang didukung
    valid_extensions = ('.jpg', '.jpeg', '.png', '.JPG', '.PNG')
    
    # Hanya scan 3 level folder agar tidak freeze
    for root, dirs, files in os.walk(start_path):
        # Hitung hanya file yang merupakan gambar di folder tersebut
        image_count = len([f for f in files if f.lower().endswith(valid_extensions)])
        
        # Jika folder berisi gambar, print detailnya
        if image_count > 0:
            print(f"{image_count:<15} | {root}")

check_dataset_detail()



