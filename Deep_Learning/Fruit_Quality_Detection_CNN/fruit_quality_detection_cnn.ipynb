# --- 3. EKSEKUSI COPY ---
def execute_copy():
    print("\n🚀 Memulai Proses Copy Data...")
    
    for item in CONFIG_COPY:
        src_path = item['src']
        dst_folder = item['dst']
        limit = item['limit']
        prefix = item['prefix']
        
        if not os.path.exists(src_path):
            print(f"❌ ERROR: Path tidak ditemukan: {src_path}")
            continue
            
        files = [f for f in os.listdir(src_path) if f.lower().endswith(('.jpg', '.png', '.jpeg', '.JPG'))]
        
        # Nama folder pendek untuk display
        short_name = src_path.split('/')[-1]
        print(f"   📂 {dst_folder.upper()}: Copy {limit} dari ...{short_name}")
        
        count = 0
        for img in tqdm(files[:limit]):
            try:
                shutil.copy(os.path.join(src_path, img), os.path.join(base_dir, dst_folder, prefix + img))
                count += 1
            except: pass

# --- 4. JALANKAN ---
execute_copy()

print("\n📊 STATISTIK DATA FINAL (Target: ~1200 per kelas):")
